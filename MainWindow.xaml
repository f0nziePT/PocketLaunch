<Window x:Class="PocketLaunch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PocketLaunch"
        mc:Ignorable="d"
        Title="PocketLaunch"
        Height="560" Width="340"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing"
        PreviewMouseMove="MainWindow_PreviewMouseMove"
        PreviewMouseLeftButtonUp="MainWindow_PreviewMouseLeftButtonUp"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Border x:Name="RootBorder"
            Background="{StaticResource WindowBackgroundBrush}"
            CornerRadius="14"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="16,14,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="PocketLaunch"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1" x:Name="ImportButton" Click="ImportButton_Click"
                        Style="{StaticResource IconButtonStyle}" ToolTip="Import backup" Margin="0,0,4,0">
                    <TextBlock Text="&#8593;" FontSize="14"/>
                </Button>

                <Button Grid.Column="2" x:Name="ExportButton" Click="ExportButton_Click"
                        Style="{StaticResource IconButtonStyle}" ToolTip="Export backup" Margin="0,0,4,0">
                    <TextBlock Text="&#8595;" FontSize="14"/>
                </Button>

                <Button Grid.Column="3" x:Name="AddButton" Click="AddButton_Click"
                        Style="{StaticResource IconButtonStyle}" ToolTip="Add shortcut">
                    <TextBlock Text="+" FontSize="16" FontWeight="Bold"/>
                </Button>
            </Grid>

            <!-- List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,0,12,12">
                <StackPanel>
                    <ItemsControl x:Name="ShortcutsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBackgroundBrush}"
                                        CornerRadius="10" Padding="10" Margin="0,0,0,8"
                                        PreviewMouseLeftButtonDown="ShortcutCard_PreviewMouseLeftButtonDown"
                                        MouseLeftButtonUp="ShortcutCard_Click"
                                        Tag="{Binding}"
                                        Cursor="Hand">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit" Tag="{Binding}" Click="EditShortcut_Click"/>
                                            <MenuItem Header="Remove" Tag="{Binding}" Click="RemoveShortcut_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0" Source="{Binding Icon}"
                                               Width="28" Height="28" Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="11" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="&#10005;"
                                                Style="{StaticResource IconButtonStyle}"
                                                Tag="{Binding}"
                                                Click="RemoveShortcut_Click"
                                                ToolTip="Remove"
                                                FontSize="11" Width="24" Height="24"/>

                                        <Rectangle Grid.Column="0" Grid.ColumnSpan="3"
                                                   Height="3" Margin="-10,-13,-10,0"
                                                   VerticalAlignment="Top"
                                                   Fill="{StaticResource AccentBrush}"
                                                   RadiusX="1.5" RadiusY="1.5"
                                                   Visibility="{Binding IsDropTargetAbove, Converter={StaticResource BoolToVisibility}}"/>

                                        <Rectangle Grid.Column="0" Grid.ColumnSpan="3"
                                                   Height="3" Margin="-10,0,-10,-11"
                                                   VerticalAlignment="Bottom"
                                                   Fill="{StaticResource AccentBrush}"
                                                   RadiusX="1.5" RadiusY="1.5"
                                                   Visibility="{Binding IsDropTargetBelow, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyStateText"
                               Text="No shortcuts yet. Tap + to add a folder or app."
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="12,40,12,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
